{
  "name": "VAULT — Personal OS",
  "short_name": "VAULT",
  "description": "One beautiful, intelligent place to manage your entire digital life: tasks, school, mail, calendar, focus and documents.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#080b14",
